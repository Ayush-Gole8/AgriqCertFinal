# Environment Configuration
NODE_ENV=development

# Server
PORT=5000
API_PREFIX=/api

# MongoDB
MONGODB_URI=mongodb://localhost:27017/agriqcert
MONGODB_TEST_URI=mongodb://localhost:27017/agriqcert_test

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# Verifiable Credentials
VC_ISSUER_DID=did:example:agriqcert
VC_VERIFICATION_METHOD=did:example:agriqcert#key-1
VC_DEFAULT_EXPIRY_DAYS=365

# Admin Setup
ADMIN_EMAIL=admin@agriqcert.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=System Administrator

# Logging
LOG_LEVEL=info

# Geolocation
MAX_LOCATION_ACCURACY_METERS=100

# QR Code
QR_BASE_URL=https://verify.agriqcert.com

# Inji Integration
INJI_ENVIRONMENT=sandbox
INJI_SANDBOX_API_URL=https://sandbox.inji.io/api
INJI_PRODUCTION_API_URL=https://api.inji.io
INJI_API_KEY=your-inji-api-key-here
INJI_CLIENT_ID=your-inji-client-id
INJI_CLIENT_SECRET=your-inji-client-secret
INJI_ISSUER_DID=did:example:agriqcert

# Inji Wallet Integration
INJI_WALLET_PUSH_ENABLED=true
INJI_WALLET_DEEPLINK_SCHEME=inji://
INJI_WALLET_APP_URL=https://wallet.inji.io

# Inji Webhook Security
INJI_WEBHOOK_ENABLED=true
INJI_WEBHOOK_SECRET=your-webhook-secret-min-32-chars
INJI_WEBHOOK_SIGNATURE_ALGORITHM=sha256
INJI_WEBHOOK_TOLERANCE_SECONDS=300
INJI_WEBHOOK_RETRY_MAX_ATTEMPTS=3

# Inji Mock/Demo Mode
INJI_MOCK_MODE=true
INJI_DEMO_MODE=false
INJI_DEMO_RECORDING_PATH=./docs/demo-recordings/
INJI_RECORD_DEMOS=false
INJI_FALLBACK_TO_DEMO_ON_ERROR=true
